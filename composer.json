{
  "name": "database-visualizer/laravel",
  "description": "A local, read-only database schema viewer for Laravel",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "database", "schema", "visualizer", "development"],
  "homepage": "https://github.com/Pasindu-Fdo/Database-Visualizer-Laravel",
  "authors": [{ "name": "Pasindu Deshan", "email": "deshanfdo27@gmail.com" }],
  "support": { "issues": "https://github.com/Pasindu-Fdo/Database-Visualizer/issues", "source": "https://github.com/Pasindu-Fdo/Database-Visualizer-Laravel" },
  "require": {
      "php": "^8.1",
      "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
      "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
      "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
      "symfony/process": "^6.2|^7.0|^8.0"
  },
  "autoload": { "psr-4": { "DatabaseVisualizer\\Laravel\\": "src/" } },
  "extra": { "laravel": { "providers": ["DatabaseVisualizer\\Laravel\\DatabaseViewerServiceProvider"] } },
  "minimum-stability": "stable",
  "prefer-stable": true
}
